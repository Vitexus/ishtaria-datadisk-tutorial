#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:
	# Validate datadisk schema
	python3 ../ishtaria-protocol/tests/validate_datadisk.py .
	
	# Render voices unless building with -Ppkg.ishtaria-datadisk-tutorial.novoice
ifeq (,$(filter pkg.ishtaria-datadisk-tutorial.novoice,$(DEB_BUILD_PROFILES)))
	python3 tools/render_voices.py --out debian/ishtaria-datadisk-tutorial/ --jobs $(shell nproc)
endif

override_dh_auto_install:
	# Install datadisk files
	mkdir -p debian/ishtaria-datadisk-tutorial/usr/share/ishtaria/datadisks/tutorial
	cp -a datadisk.yaml knowledge.yaml places npcs dialogues quests i18n music media debian/ishtaria-datadisk-tutorial/usr/share/ishtaria/datadisks/tutorial/
	
	# Install media (portraits, cover, voices)
	mkdir -p debian/ishtaria-datadisk-tutorial/usr/share/ishtaria/datadisks/tutorial/media
	cp -a media/portraits media/cover debian/ishtaria-datadisk-tutorial/usr/share/ishtaria/datadisks/tutorial/media/ 2>/dev/null || true
	cp -a debian/ishtaria-datadisk-tutorial/media/voice debian/ishtaria-datadisk-tutorial/usr/share/ishtaria/datadisks/tutorial/media/ 2>/dev/null || true
